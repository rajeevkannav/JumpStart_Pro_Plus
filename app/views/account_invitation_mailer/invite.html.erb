<div style="font-family: 'Helvetica Neue', Arial, sans-serif; color: #051c2c; line-height: 1.6; max-width: 560px;">
  <h1 style="font-family: Georgia, 'Times New Roman', serif; font-weight: normal; font-size: 24px;">You've been invited to join <%= @account_name %></h1>
  <p><%= @inviter_email %> invited you to join <strong><%= @account_name %></strong> on JumpStart Pro Plus.</p>
  <p>
    <%= link_to "Accept invitation", @url,
          style: "display: inline-block; background: #2251ff; color: #ffffff; padding: 12px 20px; text-decoration: none; font-weight: bold;" %>
  </p>
  <p style="color: #4b5a66; font-size: 14px;">The link expires in 7 days. If you don't have an account yet, sign up with <%= @invitation.email_address %> and you'll come straight back to accept.</p>
  <p style="color: #4b5a66; font-size: 14px;">If you weren't expecting this invitation, you can ignore this email.</p>
</div>
