<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Invitation</p>
    <h1 class="font-serif text-3xl text-ink font-normal">This invitation is for someone else</h1>
    <p class="mt-3 text-muted">It was sent to a different email address than the one you're signed in with. Sign out and sign in (or sign up) with the invited address to accept it.</p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= button_to "Sign out", session_path, method: :delete, class: "min-h-[44px] px-4 py-2 bg-paper border border-ink text-ink rounded-none cursor-pointer font-medium text-base hover:bg-mist focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
    <%= link_to "Go to the home page", root_path, class: "text-action hover:underline font-medium" %>
  </div>
</div>
