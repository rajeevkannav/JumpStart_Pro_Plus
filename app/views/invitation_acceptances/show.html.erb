<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Invitation</p>
    <h1 class="font-serif text-3xl text-ink font-normal break-words">Join <%= @invitation.account.name %></h1>
    <p class="mt-3 text-muted">You've been invited to join this account on JumpStart Pro Plus. Sign in, or create an account with the email address the invitation was sent to, and we'll bring you straight back to accept it.</p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= link_to "Sign in", new_session_path, class: "inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-action hover:bg-action-hover text-white font-medium rounded-none no-underline text-base focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
    <%= link_to "Sign up", new_registration_path, class: "inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-paper border border-ink text-ink font-medium rounded-none no-underline text-base hover:bg-mist focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
  </div>
</div>
