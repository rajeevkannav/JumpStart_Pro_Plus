<div class="w-full min-w-0">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Staff</p>
    <h1 class="font-serif text-3xl text-ink font-normal">Dashboard</h1>
    <p class="mt-3 text-muted">App-wide totals across every account. Visible to staff only.</p>
  </div>

  <section aria-labelledby="totals-heading">
    <h2 id="totals-heading" class="sr-only">Totals</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 border-t border-b border-rule py-4">
      <div class="min-w-0" id="staff-total-users">
        <dt class="text-xs uppercase tracking-widest text-muted font-medium">Users</dt>
        <dd class="mt-1 font-serif text-3xl text-ink"><%= number_with_delimiter(@user_count) %></dd>
      </div>
      <div class="min-w-0" id="staff-total-personal-accounts">
        <dt class="text-xs uppercase tracking-widest text-muted font-medium">Personal accounts</dt>
        <dd class="mt-1 font-serif text-3xl text-ink"><%= number_with_delimiter(@personal_account_count) %></dd>
      </div>
      <div class="min-w-0" id="staff-total-team-accounts">
        <dt class="text-xs uppercase tracking-widest text-muted font-medium">Team accounts</dt>
        <dd class="mt-1 font-serif text-3xl text-ink"><%= number_with_delimiter(@team_account_count) %></dd>
      </div>
      <div class="min-w-0" id="staff-total-pending-invitations">
        <dt class="text-xs uppercase tracking-widest text-muted font-medium">Pending invitations</dt>
        <dd class="mt-1 font-serif text-3xl text-ink"><%= number_with_delimiter(@pending_invitation_count) %></dd>
      </div>
    </dl>
  </section>

  <section class="mt-12" aria-labelledby="recent-users-heading">
    <h2 id="recent-users-heading" class="font-serif text-2xl text-ink font-normal">Newest users</h2>
    <% if @recent_users.any? %>
      <ul role="list" class="mt-4 border-t border-rule">
        <% @recent_users.each do |user| %>
          <li id="<%= dom_id(user, :staff) %>" class="border-b border-rule py-4 flex flex-wrap items-baseline justify-between gap-2">
            <span class="font-medium text-ink break-all min-w-0"><%= user.email_address %></span>
            <time datetime="<%= user.created_at.iso8601 %>" class="text-sm text-muted"><%= l(user.created_at, format: :long) %></time>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-muted">No users yet.</p>
    <% end %>
  </section>
</div>
