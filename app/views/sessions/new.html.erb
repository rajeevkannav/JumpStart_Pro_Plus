<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Account Access</p>
    <h1 class="font-serif text-3xl text-ink font-normal">Sign in</h1>
  </div>

  <%= form_with url: session_path, class: "space-y-6 w-full" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-ink mb-2" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "name@company.com", value: params[:email_address], class: "w-full min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-2">
        <%= form.label :password, "Password", class: "block text-sm font-medium text-ink" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-sm text-action hover:underline" %>
      </div>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", maxlength: 72, class: "w-full min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
    </div>

    <div>
      <%= form.submit "Sign in", class: "w-full min-h-[44px] bg-action hover:bg-action-hover text-white font-medium py-2 px-4 rounded-none cursor-pointer border-0 transition-colors text-base" %>
    </div>
  <% end %>

  <div class="mt-8 pt-6 border-t border-rule text-sm text-muted">
    Don't have an account? <%= link_to "Sign up", new_registration_path, class: "text-action hover:underline font-medium" %>
  </div>
</div>
