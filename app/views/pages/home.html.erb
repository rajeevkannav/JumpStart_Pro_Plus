<div class="flex flex-col items-center justify-center min-h-[60vh] py-2">
  <h1 class="text-6xl font-bold">Welcome to JumpStart Pro Plus</h1>
  <p class="mt-3 text-2xl">
    A clean-room Rails 8 SaaS starter.
  </p>
  <div class="mt-6 flex gap-4">
    <% if authenticated? %>
      <div class="flex flex-col items-center gap-4">
        <p>Logged in as: <span class="font-semibold"><%= Current.user.email_address %></span></p>
        <%= button_to "Sign out", session_path, method: :delete, class: "rounded-lg py-3 px-5 bg-neutral-100 font-medium cursor-pointer hover:bg-neutral-200 transition-colors" %>
      </div>
    <% else %>
      <%= link_to "Sign in", new_session_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors" %>
      <%= link_to "Sign up", new_registration_path, class: "rounded-lg py-3 px-5 bg-green-600 text-white font-medium hover:bg-green-700 transition-colors" %>
    <% end %>
  </div>
</div>
