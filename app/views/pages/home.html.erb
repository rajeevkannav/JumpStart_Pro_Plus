<main class="min-h-screen flex flex-col items-center justify-center p-6 bg-[var(--qb-canvas)] text-[var(--qb-text)] transition-colors duration-300">
  <div class="w-full max-w-md p-8 rounded-xl bg-[var(--qb-surface)] border border-[var(--qb-border)] shadow-2xl">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-[var(--qb-accent)] font-sans">
        Jumpstart Pro Plus
      </h1>
      <p class="text-sm font-mono mt-2 opacity-70">
        <%= app_environment %> • <%= build_sha %>
      </p>
    </header>

    <section class="space-y-6">
      <div class="flex items-center justify-between p-4 rounded-lg bg-[var(--qb-canvas)] border border-[var(--qb-border)]">
        <span class="text-sm font-medium">Database Status</span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium <%= database_status == "Connected" ? "bg-teal-400/10 text-teal-400" : "bg-rose-400/10 text-rose-400" %>">
          <%= database_status %>
        </span>
      </div>

      <div class="pt-4 border-t border-[var(--qb-border)]">
        <p class="text-xs text-slate-500 font-mono">
          Rails <%= Rails.version %> • Ruby <%= RUBY_VERSION %>
        </p>
      </div>
    </section>
  </div>
</main>