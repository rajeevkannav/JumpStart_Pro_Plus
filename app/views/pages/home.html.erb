<div class="py-6 sm:py-12">
  <div class="max-w-3xl">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-3">Enterprise SaaS Starter</p>
    <h1 class="font-serif text-3xl sm:text-4xl text-ink font-normal leading-tight mb-4">
      Welcome to JumpStart Pro Plus
    </h1>
    <p class="text-lg text-muted mb-8 leading-relaxed">
      A high-performance Rails 8 foundation featuring light-only consulting aesthetics, Hotwire reactivity, and multi-tenant isolation.
    </p>

    <div class="pt-6 border-t border-rule flex flex-wrap gap-4 items-center">
      <% if authenticated? %>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <p class="text-sm text-ink">
            Signed in as <span class="font-semibold text-ink"><%= Current.user.email_address %></span>
          </p>
          <%= button_to "Sign out", session_path, method: :delete, class: "inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-transparent border border-ink text-ink font-medium hover:bg-mist transition-colors cursor-pointer rounded-none text-sm" %>
        </div>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-action hover:bg-action-hover text-white font-medium transition-colors cursor-pointer rounded-none text-sm no-underline" %>
        <%= link_to "Sign up", new_registration_path, class: "inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-transparent border border-ink text-ink font-medium hover:bg-mist transition-colors cursor-pointer rounded-none text-sm no-underline" %>
      <% end %>
    </div>
  </div>
</div>
