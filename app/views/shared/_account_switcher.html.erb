<%# Navbar account switcher. A native <details> disclosure: no JS needed,
    keyboard accessible, and the menu sits in the page flow below 640px so
    it wraps instead of overflowing at 320px. Lists only Current.user's
    accounts. %>
<% accounts = Current.user.accounts.order(personal: :desc, name: :asc) %>
<details id="account-switcher" class="account-switcher relative w-full sm:w-auto min-w-0 order-last sm:order-none">
  <summary class="list-none cursor-pointer inline-flex items-center gap-2 min-h-[44px] px-3 border border-white/40 text-white font-medium text-xs sm:text-sm max-w-full hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2">
    <span class="sr-only">Current account:</span>
    <span class="truncate max-w-[200px] sm:max-w-[220px]"><%= Current.account.name %></span>
    <svg aria-hidden="true" class="account-switcher-caret w-3 h-3 shrink-0" viewBox="0 0 12 12" fill="currentColor"><path d="M2 4l4 4 4-4z"/></svg>
  </summary>

  <div class="mt-2 w-full sm:absolute sm:right-0 sm:z-20 sm:w-72 bg-paper text-ink border border-rule border-t-4 border-t-accent">
    <p id="account-switcher-heading" class="px-4 pt-3 pb-1 text-xs uppercase tracking-widest text-muted font-medium">Switch account</p>
    <ul role="list" aria-labelledby="account-switcher-heading">
      <% accounts.each do |account| %>
        <li class="border-b border-rule">
          <% if account == Current.account %>
            <span class="flex items-center justify-between gap-2 min-h-[44px] px-4 py-2 text-sm font-medium" aria-current="true">
              <span class="min-w-0 break-all"><%= account.name %></span>
              <span class="text-xs text-success shrink-0">Current</span>
            </span>
          <% else %>
            <%= button_to account_switch_path(account), form: { class: "m-0" },
                  class: "w-full text-left flex items-center justify-between gap-2 min-h-[44px] px-4 py-2 text-sm bg-paper text-action border-0 cursor-pointer hover:bg-mist hover:underline focus-visible:outline-2 focus-visible:outline-action focus-visible:-outline-offset-2" do %>
              <span class="min-w-0 break-all"><%= account.name %></span>
              <span class="sr-only">(switch)</span>
              <span class="text-xs text-muted shrink-0"><%= account.personal? ? "Personal" : "Team" %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <div class="flex flex-col py-1">
      <%= link_to "New team account", new_account_path, class: "flex items-center min-h-[44px] px-4 text-sm text-action font-medium hover:underline focus-visible:outline-2 focus-visible:outline-action focus-visible:-outline-offset-2" %>
      <%= link_to "Account", current_account_path, class: "flex items-center min-h-[44px] px-4 text-sm text-action hover:underline focus-visible:outline-2 focus-visible:outline-action focus-visible:-outline-offset-2" %>
      <%= link_to "Accounts", accounts_path, class: "flex items-center min-h-[44px] px-4 text-sm text-action hover:underline focus-visible:outline-2 focus-visible:outline-action focus-visible:-outline-offset-2" %>
    </div>
  </div>
</details>
