<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Account Security</p>
    <h1 class="font-serif text-3xl text-ink font-normal">Delete your account</h1>
    <p class="mt-3 text-muted">You will be signed out on every device and will no longer be able to sign in. Your email address will be freed so it can be used to sign up again.</p>
  </div>

  <%= form_with url: settings_account_deletion_path, class: "space-y-6 w-full" do |form| %>
    <div>
      <%= form.label :confirmation, "Type DELETE to confirm", class: "block text-sm font-medium text-ink mb-2" %>
      <%= form.text_field :confirmation, required: true, autofocus: true, autocomplete: "off", autocapitalize: "characters", spellcheck: false, maxlength: 20,
            aria: { describedby: "confirmation-hint" },
            class: "w-full min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
      <p id="confirmation-hint" class="mt-2 text-sm text-muted">This cannot be undone from the app.</p>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit "Delete my account", class: "min-h-[44px] bg-danger text-white font-medium py-2 px-4 rounded-none cursor-pointer border-0 text-base hover:opacity-90 focus-visible:outline-2 focus-visible:outline-action" %>
      <%= link_to "Cancel", settings_sessions_path, class: "text-action hover:underline font-medium" %>
    </div>
  <% end %>
</div>
