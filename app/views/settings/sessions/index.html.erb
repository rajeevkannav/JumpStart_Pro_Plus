<div class="w-full min-w-0">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Account Security</p>
    <h1 class="font-serif text-3xl text-ink font-normal">Active sessions</h1>
    <p class="mt-3 text-muted">These are the devices signed in to your account. Signing out a session requires confirming your password.</p>
  </div>

  <ul role="list" class="border-t border-rule">
    <% @sessions.each do |session| %>
      <% current = session == Current.session %>
      <% device = short_user_agent(session.user_agent) %>
      <% ip = session.ip_address.presence || "Unknown IP" %>
      <li id="<%= dom_id(session) %>" class="border-b border-rule py-4 flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="font-medium text-ink break-words">
            <%= device %>
            <% if current %>
              <span class="ml-2 text-xs uppercase tracking-widest text-success font-medium">This device</span>
            <% end %>
          </p>
          <p class="text-sm text-muted break-words">
            <%= ip %> &middot; Signed in <time datetime="<%= session.created_at.iso8601 %>"><%= l(session.created_at, format: :long) %></time>
          </p>
        </div>
        <% unless current %>
          <%= button_to "Sign out", settings_session_path(session), method: :delete,
                aria: { label: "Sign out #{device} session from #{ip}" },
                class: "min-h-[44px] px-4 py-2 bg-paper text-danger border border-danger rounded-none cursor-pointer font-medium text-sm hover:bg-mist focus-visible:outline-2 focus-visible:outline-action" %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if @sessions.size > 1 %>
    <div class="mt-8">
      <%= button_to "Sign out of all other sessions", others_settings_sessions_path, method: :delete,
            class: "min-h-[44px] px-4 py-2 bg-danger text-white border-0 rounded-none cursor-pointer font-medium text-base hover:opacity-90 focus-visible:outline-2 focus-visible:outline-action" %>
    </div>
  <% end %>

  <section class="mt-12 pt-8 border-t border-rule" aria-labelledby="two-factor-heading">
    <h2 id="two-factor-heading" class="font-serif text-2xl text-ink font-normal">Sign-in security</h2>
    <p class="mt-2 text-muted">Require a code from an authenticator app as well as your password.</p>
    <p class="mt-4 flex flex-wrap items-center gap-3">
      <%= link_to "Two-factor authentication", settings_two_factor_path, class: "text-action font-medium underline hover:no-underline" %>
      <% if Current.user.two_factor_enabled? %>
        <span class="text-xs uppercase tracking-widest text-success font-medium">On</span>
      <% else %>
        <span class="text-xs uppercase tracking-widest text-muted font-medium">Off</span>
      <% end %>
    </p>
  </section>

  <section class="mt-12 pt-8 border-t border-rule" aria-labelledby="delete-account-heading">
    <h2 id="delete-account-heading" class="font-serif text-2xl text-ink font-normal">Delete account</h2>
    <p class="mt-2 text-muted">Permanently close your account and sign out everywhere.</p>
    <%= link_to "Delete my account", settings_new_account_deletion_path, class: "inline-block mt-4 text-danger font-medium underline hover:no-underline" %>
  </section>
</div>
