<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Account Security</p>
    <h1 class="font-serif text-3xl text-ink font-normal">Save your recovery codes</h1>
    <p class="mt-3 text-muted">If you lose access to your authenticator app, each of these codes can be used once instead of a 6-digit code.</p>
  </div>

  <div class="bg-warning-bg text-warning-text border-l-4 border-warning-text p-4 text-sm font-medium" role="note">
    Store them somewhere safe now. This is the only time they will be shown.
  </div>

  <ul role="list" aria-label="Recovery codes" class="mt-6 grid grid-cols-1 min-[360px]:grid-cols-2 gap-2 border-y border-rule py-4 font-mono text-base text-ink">
    <% @recovery_codes.each do |code| %>
      <li class="break-all"><%= code %></li>
    <% end %>
  </ul>

  <div class="mt-8 flex flex-wrap items-center gap-4">
    <%= link_to "I've saved my recovery codes", settings_two_factor_path,
          class: "inline-flex items-center min-h-[44px] bg-action hover:bg-action-hover text-white font-medium py-2 px-4 rounded-none no-underline text-base focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
  </div>
</div>
