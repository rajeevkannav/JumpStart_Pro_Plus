<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1">Account Security</p>
    <h1 class="font-serif text-3xl text-ink font-normal">Two-factor authentication</h1>
    <p class="mt-3 text-muted">Protect your account with a 6-digit code from an authenticator app, as well as your password.</p>
  </div>

  <p class="border-y border-rule py-4 text-ink">
    Status:
    <% if Current.user.two_factor_enabled? %>
      <strong class="text-success font-medium">On</strong>
      <span class="text-muted">since <time datetime="<%= Current.user.otp_enabled_at.iso8601 %>"><%= l(Current.user.otp_enabled_at.to_date, format: :long) %></time></span>
    <% else %>
      <strong class="text-ink font-medium">Off</strong>
    <% end %>
  </p>

  <% if Current.user.two_factor_enabled? %>
    <section class="mt-8" aria-labelledby="disable-two-factor-heading">
      <h2 id="disable-two-factor-heading" class="font-serif text-2xl text-ink font-normal">Turn off two-factor authentication</h2>
      <p class="mt-2 text-muted">Enter a code from your authenticator app, or one of your recovery codes, to confirm.</p>

      <%= form_with url: settings_two_factor_path, method: :delete, class: "mt-6 space-y-6 w-full" do |form| %>
        <div>
          <%= form.label :code, "Authentication or recovery code", class: "block text-sm font-medium text-ink mb-2" %>
          <%= form.text_field :code, required: true, autocomplete: "one-time-code", autocapitalize: "off", spellcheck: false, maxlength: 20,
                class: "w-full min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <%= form.submit "Turn off two-factor authentication", class: "min-h-[44px] bg-danger text-white font-medium py-2 px-4 rounded-none cursor-pointer border-0 text-base hover:opacity-90 focus-visible:outline-2 focus-visible:outline-action" %>
          <%= link_to "Back to settings", settings_sessions_path, class: "text-action hover:underline font-medium" %>
        </div>
      <% end %>
    </section>
  <% else %>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <%= link_to "Set up two-factor authentication", new_settings_two_factor_path,
            class: "inline-flex items-center min-h-[44px] bg-action hover:bg-action-hover text-white font-medium py-2 px-4 rounded-none no-underline text-base focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
      <%= link_to "Back to settings", settings_sessions_path, class: "text-action hover:underline font-medium" %>
    </div>
  <% end %>
</div>
