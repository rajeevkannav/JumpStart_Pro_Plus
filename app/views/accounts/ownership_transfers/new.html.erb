<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1 break-all"><%= Current.account.name %></p>
    <h1 class="font-serif text-3xl text-ink font-normal">Transfer ownership</h1>
    <p class="mt-3 text-muted">The new owner can manage members, invitations and the account itself. You'll stay on as a member.</p>
  </div>

  <% if @candidates.any? %>
    <%= form_with url: account_ownership_transfer_path, class: "space-y-6 w-full" do |form| %>
      <div>
        <%= form.label :user_id, "New owner", class: "block text-sm font-medium text-ink mb-2" %>
        <%= form.select :user_id,
              options_for_select(@candidates.map { |m| [ m.user.email_address, m.user_id ] }),
              { include_blank: "Choose a member" },
              required: true, autofocus: true,
              class: "w-full min-w-0 min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <%= form.submit "Transfer ownership",
              data: { turbo_confirm: "Transfer #{Current.account.name}? You'll no longer be its owner." },
              class: "min-h-[44px] bg-danger text-white font-medium py-2 px-4 rounded-none cursor-pointer border-0 text-base hover:opacity-90 focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
        <%= link_to "Cancel", account_members_path, class: "text-action hover:underline font-medium" %>
      </div>
    <% end %>
  <% else %>
    <p class="border-t border-b border-rule py-4 text-muted">There's nobody else in this account yet. Invite a member first, then come back to hand it over.</p>
    <p class="mt-8 flex flex-wrap gap-4">
      <%= link_to "Invite members", account_invitations_path, class: "text-action hover:underline font-medium" %>
      <%= link_to "Back to members", account_members_path, class: "text-action hover:underline font-medium" %>
    </p>
  <% end %>
</div>
