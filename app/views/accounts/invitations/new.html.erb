<div class="max-w-md mx-auto w-full box-border">
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1"><%= Current.account.name %></p>
    <h1 class="font-serif text-3xl text-ink font-normal">Invite a member</h1>
    <p class="mt-3 text-muted">We'll email a link to join this account as a member. The link works once and expires in 7 days.</p>
  </div>

  <%= render "shared/error_summary", record: @invitation %>

  <%= form_with model: @invitation, url: account_invitations_path, class: "space-y-6 w-full" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-ink mb-2" %>
      <%= form.email_field :email_address, required: true, autofocus: true, maxlength: 254, autocomplete: "off",
            placeholder: "name@company.com",
            aria: { invalid: @invitation.errors[:email_address].any? || nil },
            class: "w-full min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit "Send invitation", class: "min-h-[44px] bg-action hover:bg-action-hover text-white font-medium py-2 px-4 rounded-none cursor-pointer border-0 transition-colors text-base focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
      <%= link_to "Cancel", account_invitations_path, class: "text-action hover:underline font-medium" %>
    </div>
  <% end %>
</div>
