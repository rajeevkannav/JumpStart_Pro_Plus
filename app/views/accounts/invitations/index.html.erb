<div class="w-full min-w-0">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <p class="text-xs uppercase tracking-widest text-muted font-medium mb-1 break-all"><%= Current.account.name %></p>
      <h1 class="font-serif text-3xl text-ink font-normal">Invitations</h1>
      <p class="mt-3 text-muted">Pending invitations to this account. Each link works once and expires after 7 days.</p>
    </div>
    <%= link_to "Invite a member", new_account_invitation_path, class: "inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-action hover:bg-action-hover text-white font-medium rounded-none no-underline text-sm focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
  </div>

  <section aria-labelledby="pending-invitations-heading">
    <h2 id="pending-invitations-heading" class="font-serif text-2xl text-ink font-normal mb-4">Pending</h2>
    <% if @invitations.any? %>
      <ul role="list" class="border-t border-rule">
        <% @invitations.each do |invitation| %>
          <li id="<%= dom_id(invitation) %>" class="border-b border-rule py-4 flex flex-wrap items-center justify-between gap-4">
            <div class="min-w-0">
              <p class="font-medium text-ink break-all"><%= invitation.email_address %></p>
              <p class="text-sm text-muted">
                Invited by <span class="break-all"><%= invitation.invited_by.email_address %></span>
                &middot; expires <%= l(invitation.expires_at.to_date, format: :long) %>
              </p>
            </div>
            <%= button_to "Revoke", account_invitation_path(invitation), method: :delete,
                  form: { data: { turbo_confirm: "Revoke the invitation to #{invitation.email_address}?" } },
                  aria: { label: "Revoke invitation to #{invitation.email_address}" },
                  class: "min-h-[44px] px-4 py-2 bg-paper border border-danger text-danger rounded-none cursor-pointer font-medium text-sm hover:bg-mist focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="border-t border-b border-rule py-4 text-muted">No pending invitations.</p>
    <% end %>
  </section>

  <p class="mt-8"><%= link_to "Back to account", current_account_path, class: "text-action hover:underline font-medium" %></p>
</div>
