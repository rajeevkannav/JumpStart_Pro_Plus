<%= render "shared/error_summary", record: account %>

<%= form_with model: account, class: "space-y-6 w-full" do |form| %>
  <div>
    <%= form.label :name, "Account name", class: "block text-sm font-medium text-ink mb-2" %>
    <%= form.text_field :name, required: true, autofocus: true, maxlength: 100, autocomplete: "organization",
          aria: { invalid: account.errors[:name].any? || nil },
          class: "w-full min-h-[44px] px-3 py-2 border border-rule rounded-none text-base text-ink bg-paper focus:outline-none focus:ring-2 focus:ring-action focus:border-transparent box-border" %>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit submit_label, class: "min-h-[44px] bg-action hover:bg-action-hover text-white font-medium py-2 px-4 rounded-none cursor-pointer border-0 transition-colors text-base focus-visible:outline-2 focus-visible:outline-action focus-visible:outline-offset-2" %>
    <%= link_to "Cancel", cancel_path, class: "text-action hover:underline font-medium" %>
  </div>
<% end %>
